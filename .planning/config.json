{
  "mode": "yolo",
  "granularity": "standard",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "balanced",
  "workflow": {
    "research": true,
    "plan_check": true,
    "plan_review_convergence": true,
    "verifier": true,
    "nyquist_validation": true,
    "ai_integration_phase": true,
    "auto_advance": false,
    "_auto_chain_active": false,
    "use_worktrees": false
  },
  "graphify": {
    "enabled": true,
    "auto_update": true,
    "llm_backend": {
      "provider": "atius-router-gpt",
      "config_file": "~/.graphify/providers.json",
      "model": "gpt-5.4-mini",
      "streaming_patch": "~/.local/share/graphify-patches/graphify_atius_router_patch.py"
    },
    "embedding": {
      "provider": "atius-router",
      "config_file": "~/.graphify/embeddings.json",
      "helper": "~/.local/bin/graphify-embed",
      "base_url": "https://router.atius.com.br/v1",
      "model": "embedding-gte-v1",
      "dimensions": 768,
      "max_batch_size": 4,
      "governor_header": "X-Embedding-Workload: batch",
      "role": "auxiliary_retrieval"
    }
  },
  "runtime": "codex"
}
