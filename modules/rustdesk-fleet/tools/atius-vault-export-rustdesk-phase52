#!/usr/bin/env bash
# Exact read-only srv3 backend. Values stay inside bounded private pipes.
set -euo pipefail
set +x
IFS=$'\n\t'
umask 077

[[ $# -eq 1 ]] || exit 64
case "$1" in
  rustdesk-phase52-v1|rclone-giovanni-drive-phase52-v1) protocol=$1 ;;
  *) exit 64 ;;
esac

exec python3 -c '
import json,os,pathlib,selectors,signal,stat,subprocess,sys,time
protocol=sys.argv[1]
max_request=16384; max_stdout=131072; max_stderr=4096
root_prefix_from_self=pathlib.Path(sys.argv[2]).resolve().as_posix().removesuffix("/usr/local/sbin/atius-vault-export-rustdesk-phase52") or "/"
def pairs(items):
 result={}
 for key,value in items:
  if key in result: raise ValueError("duplicate")
  result[key]=value
 return result
raw=sys.stdin.buffer.read(max_request+1)
if len(raw)>max_request: raise SystemExit(2)
try: request=json.loads(raw.decode(),object_pairs_hook=pairs)
except Exception: raise SystemExit(2)
profile_root=pathlib.Path(os.environ.get("ATIUS_PHASE52_PROFILE_ROOT",root_prefix_from_self+"/etc/atius-vault/profiles"))
profile=profile_root/(protocol+".json")
try:
 info=profile.lstat()
 if profile.is_symlink() or not stat.S_ISREG(info.st_mode) or info.st_nlink!=1 or stat.S_IMODE(info.st_mode)!=0o600: raise ValueError
 if os.geteuid()==0 and (info.st_uid!=0 or info.st_gid!=0): raise ValueError
 spec=json.loads(profile.read_text(),object_pairs_hook=pairs)
except Exception: raise SystemExit(2)
if not isinstance(spec,dict) or set(spec)!={"protocol","references"} or spec["protocol"]!=protocol or request!={"protocol":protocol,"references":spec["references"]}: raise SystemExit(2)
vault=os.environ.get("ATIUS_PHASE52_VAULT_BIN",root_prefix_from_self+"/usr/local/sbin/atius-vault")
global_deadline=time.monotonic()+30
mode_as_uid_proof={"mode":"sudo-root" if os.geteuid()==0 else "fixture-current-uid","uid":os.geteuid()}
def kill_process_group(process):
 try: os.killpg(process.pid,signal.SIGKILL)
 except ProcessLookupError: pass
 try: process.wait(timeout=2)
 except subprocess.SubprocessError: pass
def bounded(command):
 process=subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,bufsize=0,start_new_session=True)
 selector=selectors.DefaultSelector(); chunks={"stdout":[],"stderr":[]}; sizes={"stdout":0,"stderr":0}; deadline=global_deadline
 try:
  selector.register(process.stdout,selectors.EVENT_READ,("stdout",max_stdout)); selector.register(process.stderr,selectors.EVENT_READ,("stderr",max_stderr))
  while selector.get_map():
   remaining=deadline-time.monotonic()
   if remaining<=0: raise TimeoutError
   events=selector.select(remaining)
   if not events: raise TimeoutError
   for key,_ in events:
    name,limit=key.data; chunk=os.read(key.fd,8192)
    if not chunk: selector.unregister(key.fileobj); continue
    sizes[name]+=len(chunk)
    if sizes[name]>limit: raise OverflowError
    chunks[name].append(chunk)
  return process.wait(timeout=max(.01,deadline-time.monotonic())),b"".join(chunks["stdout"]),b"".join(chunks["stderr"])
 except BaseException:
  kill_process_group(process)
  raise
 finally: selector.close()
values={}; cache={}
try:
 for reference in spec["references"]:
  if not isinstance(reference,dict) or set(reference)!={"vault_path","field"}: raise ValueError
  path=reference["vault_path"]; field=reference["field"]
  if path not in cache:
   code,out,err=bounded([vault, "kv", "get", "-format=json", path])
   if code or err: raise ValueError
   payload=json.loads(out.decode(),object_pairs_hook=pairs)
   cache[path]=payload["data"]["data"]
  value=cache[path].get(field)
  if not isinstance(value,str) or not value: raise ValueError
  values[path+"#"+field]=value
except Exception: raise SystemExit(2)
encoded=json.dumps({"request_count":len(spec["references"]),"values":values},sort_keys=True,separators=(",",":")).encode()
if len(encoded)>max_stdout: raise SystemExit(2)
os.write(sys.stdout.fileno(),encoded)
' "$protocol" "$0"
