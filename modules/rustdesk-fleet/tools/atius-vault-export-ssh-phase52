#!/usr/bin/env bash
# Forced-command compatibility dispatcher. Exact Phase 52 protocols are added;
# the existing validated `atius-vault-env PROFILE...` grammar remains delegated.
set -euo pipefail
set +x
IFS=$'\n\t'
umask 077

phase52_managed_path() {
  local root=$1 relative=$2
  [[ "$root" == /* && "$relative" != /* && -n "$relative" ]] || return 64
  if [[ "$root" == / ]]; then
    printf '/%s' "$relative"
  else
    printf '%s/%s' "$root" "$relative"
  fi
}

# Tests source this file to exercise the same path resolver used by the live
# dispatcher without touching /usr/local or widening the forced-command API.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

root_prefix_from_self=$(realpath -e -- "$0")
root_prefix_from_self=${root_prefix_from_self%/usr/local/sbin/atius-vault-export-ssh-phase52}
[[ -n "$root_prefix_from_self" ]] || root_prefix_from_self=/
BACKEND=$(phase52_managed_path "$root_prefix_from_self" usr/local/sbin/atius-vault-export-rustdesk-phase52)
LEGACY=$(phase52_managed_path "$root_prefix_from_self" home/ubuntu/.local/bin/atius-vault-export-ssh)
readonly BACKEND LEGACY
readonly legacy_command_max_bytes=16384
[[ $# -eq 0 ]] || exit 64
original=${SSH_ORIGINAL_COMMAND-}
(( ${#original} <= legacy_command_max_bytes )) || exit 64
case "$original" in
  rustdesk-phase52-v1) [[ -f "$BACKEND" && ! -L "$BACKEND" ]] || exit 2; exec sudo -n -- "$BACKEND" rustdesk-phase52-v1 ;;
  rclone-giovanni-drive-phase52-v1) [[ -f "$BACKEND" && ! -L "$BACKEND" ]] || exit 2; exec sudo -n -- "$BACKEND" rclone-giovanni-drive-phase52-v1 ;;
  atius-vault-env) [[ -x "$LEGACY" ]] || exit 2; exec "$LEGACY" ;;
  atius-vault-env\ *)
    [[ "$original" =~ ^atius-vault-env(\ [A-Za-z0-9_.:-]+)*$ ]] || exit 64
    [[ -x "$LEGACY" ]] || exit 2
    exec "$LEGACY"
    ;;
  *) exit 64 ;;
esac
