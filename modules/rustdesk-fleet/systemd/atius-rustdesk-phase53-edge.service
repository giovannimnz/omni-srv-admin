[Unit]
Description=ATIUS RustDesk Phase 53 owned public edge policy
Documentation=https://github.com/giovannimuniz/omni-srv-admin
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/test -r /etc/atius-rustdesk/phase53-edge.nft
ExecStartPre=/usr/bin/test -r /etc/atius-rustdesk/phase53-edge.template.nft
ExecStartPre=/usr/bin/test -r /etc/atius-rustdesk/phase53-edge.json
ExecStartPre=/usr/bin/test -x /usr/local/libexec/apply-phase53-edge.py
ExecStart=/usr/local/libexec/apply-phase53-edge.py --apply-host-policy-transaction --candidate /etc/atius-rustdesk/phase53-edge.nft --contract /etc/atius-rustdesk/phase53-edge.json --template /etc/atius-rustdesk/phase53-edge.template.nft --snapshot /run/atius-rustdesk-phase53-edge/nft-prestate.json
ExecStop=/usr/local/libexec/apply-phase53-edge.py --restore-host-policy-snapshot --snapshot /run/atius-rustdesk-phase53-edge/nft-prestate.json
RemainAfterExit=yes
RuntimeDirectory=atius-rustdesk-phase53-edge
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=network-pre.target
