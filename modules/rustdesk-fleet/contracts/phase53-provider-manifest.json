{
  "schema_version": 2,
  "phase": 53,
  "workstream": "rustdesk-fleet",
  "manifest_id": "phase53-production-providers-v1",
  "execution_target": "10.21.1.21",
  "edge_contract": "modules/rustdesk-fleet/contracts/phase53-edge.json",
  "capability_profiles": {
    "read_only": ["read", "preview"],
    "apply": ["read", "preview", "mutate", "contain", "rollback", "restore"]
  },
  "backends": {
    "read_only": "phase53-read-only-v1",
    "apply": "phase53-apply-v1"
  },
  "routes": {
    "ssh": {
      "private_first": [
        "ssh muniz@10.100.100.8",
        "ssh -p 8122 muniz@ssh-giovanni-w11-pc.atius.com.br"
      ],
      "fallback_only_on": ["tcp-or-banner-or-ssh-rc255"],
      "batch_mode": true,
      "stdin_safe": true,
      "known_hosts_required": true
    },
    "vault": {
      "provider": "hashicorp-vault",
      "profile": "rustdesk",
      "path_refs": [
        "kv/atius/rustdesk/server",
        "kv/atius/rustdesk/targets/atius-srv-1",
        "kv/atius/rustdesk/targets/atius-srv-2",
        "kv/atius/rustdesk/targets/atius-srv-3",
        "kv/atius/rustdesk/targets/horistic-srv",
        "kv/atius/rustdesk/targets/giovanni-w11-pc"
      ],
      "value_free_output": true
    },
    "oci": {
      "provider": "oci-admin-http",
      "client_name": "oci_admin_http",
      "read_write_cas": true,
      "target_scope": "rustdesk-phase53-owned-ingress",
      "execution_targets": {
        "public_edge": {
          "host": "atius-srv-1",
          "private_ipv4": "10.0.0.238",
          "capabilities": ["nft-dnat", "nft-forward", "nft-snat", "oci-edge-ingress"]
        },
        "backend": {
          "host": "horistic-srv",
          "private_ipv4": "10.21.1.21",
          "capabilities": ["rustdesk-server", "native-ingress-source-restriction"]
        }
      }
    },
    "cloudflare": {
      "provider": "cloudflare-api",
      "operation": "dns-snapshot-apply-restore",
      "records": [
        "rustdesk.atius.com.br",
        "rustdesk-id.atius.com.br",
        "rustdesk-relay.atius.com.br"
      ]
    },
    "apache": {
      "operation": "configtest-reload-rollback",
      "vhost": "rustdesk-ops.atius.com.br"
    }
  },
  "command_classes": {
    "allowlisted": [
      "ssh-batch-safe",
      "vault-profile-dispatch",
      "oci-cas-read-write",
      "cloudflare-dns-cas",
      "apache-configtest-reload",
      "rustdesk-server-transaction",
      "rustdesk-edge-transaction",
      "two-origin-probes"
    ],
    "forbidden": ["shell-eval", "ambient-path-search", "ambient-ssh-config", "raw-secret-output"]
  },
  "limits": {
    "command_timeout_seconds": 30,
    "max_stdout_bytes": 131072,
    "max_stderr_bytes": 8192,
    "journal_mode": "value-free-0600"
  },
  "secret_material_present": false
}
