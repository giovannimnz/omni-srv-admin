{
  "schema_version": 1,
  "workstream": "rustdesk-fleet",
  "included_hosts": [
    "atius-srv-1",
    "atius-srv-2",
    "atius-srv-3",
    "horistic-srv",
    "GIOVANNI-W11-PC"
  ],
  "excluded_hosts": [
    "WSL",
    "GIOVANNI-S23"
  ],
  "preserved_access_tools": [
    {
      "id": "RustGuac",
      "action": "preserve",
      "independently_usable": true
    },
    {
      "id": "XRDP",
      "action": "preserve",
      "independently_usable": true
    },
    {
      "id": "AnyDesk",
      "action": "preserve",
      "independently_usable": true
    },
    {
      "id": "NoMachine",
      "action": "preserve",
      "independently_usable": true
    },
    {
      "id": "noVNC",
      "action": "preserve",
      "independently_usable": true
    }
  ],
  "production_transport": {
    "policy": "direct-first",
    "force_relay_default": false,
    "forced_relay_allowed_purposes": [
      "controlled-validation",
      "proven-fallback"
    ]
  },
  "gsd_lifecycle": {
    "required_workstream": "rustdesk-fleet",
    "required_flag": "--ws",
    "mutating_verbs": [
      "begin-phase",
      "advance-plan",
      "update-progress",
      "complete-phase",
      "complete-milestone",
      "plan-phase",
      "execute-phase",
      "verify-work"
    ],
    "command_sources": [
      "fenced-shell",
      "script"
    ]
  },
  "shared_writers": {
    "mode": "serialized-single-writer",
    "paths": [
      ".planning/PROJECT.md",
      ".planning/MILESTONES.md",
      ".planning/graphs/graph.json",
      ".planning/graphs/GRAPH_REPORT.md",
      ".planning/graphs/manifest.json"
    ]
  },
  "transition_gates": {
    "precheck_ids": [
      "P51-WS-001"
    ],
    "postcheck_ids": [
      "P51-P48-001"
    ]
  }
}
