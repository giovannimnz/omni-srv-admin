#!/usr/bin/env bash
set -euo pipefail
if [ "$#" -lt 1 ]; then
  echo "usage: atius-vault-env <profile> [profile...]" >&2
  exit 2
fi
args=()
for arg in "$@"; do
  case "$arg" in
    router-ai-atius|atius-mcp|omni-fleet|landscape|landscape-client|xrdp-srv4|obsidian-readonly) args+=("$arg") ;;
    *) echo "profile not allowed by OCI bootstrap helper: $arg" >&2; exit 2 ;;
  esac
done
key="$HOME/.ssh/id_ed25519_atius_vault"
known_hosts="$HOME/.config/omni/atius-srv3-vault-known-hosts"
[ -f "$key" ] && [ ! -L "$key" ] && [ "$(stat -c %a "$key")" = "600" ] || {
  echo "restricted Vault SSH key missing or unsafe: $key" >&2
  exit 1
}
[ -f "$known_hosts" ] && [ ! -L "$known_hosts" ] && [ "$(stat -c %a "$known_hosts")" = "600" ] || {
  echo "pinned Vault known_hosts missing or unsafe: $known_hosts" >&2
  exit 1
}
exec ssh -F /dev/null -n -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 \
  -o ProxyCommand=none -o GlobalKnownHostsFile=/dev/null -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile="$known_hosts" -o HostKeyAlgorithms=ssh-ed25519 -o IPQoS=none \
  ubuntu@10.13.1.13 "atius-vault-env ${args[*]}"
