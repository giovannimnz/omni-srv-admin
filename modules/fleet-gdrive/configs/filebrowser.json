{
  "port": 8082,
  "baseURL": "",
  "address": "127.0.0.1",
  "log": "stdout",
  "database": "/var/lib/filebrowser/filebrowser.db",
  "root": "/mnt/gdrive",
  "auth": {
    "method": "proxy",
    "header": "X-Forwarded-User"
  },
  "signup": false,
  "createUserDir": false,
  "branding": {
    "name": "Atius Storage",
    "disableExternal": true,
    "files": ""
  },
  "defaults": {
    "scope": ".",
    "locale": "pt-br",
    "viewMode": "mosaic",
    "singleClick": false,
    "sorting": {
      "by": "name",
      "asc": true
    },
    "perm": {
      "admin": false,
      "execute": false,
      "create": true,
      "rename": true,
      "modify": true,
      "delete": true,
      "share": true,
      "download": true
    }
  }
}
