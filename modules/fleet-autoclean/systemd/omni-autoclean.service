[Unit]
Description=Omni fleet autoclean and log purge
Documentation=file:///home/ubuntu/GitHub/omni-srv-admin/docs/operations/fleet-autoclean.md

[Service]
Type=oneshot
User=root
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/bin/bash /home/ubuntu/GitHub/omni-srv-admin/modules/landscape-control-plane/scripts/fleet-autoclean-and-log-purge.sh
StandardOutput=journal
StandardError=journal
TimeoutSec=600
