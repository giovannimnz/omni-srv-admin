#!/bin/sh
set -eu

src="/usr/local/share/xrdp-abnt2"
dst="/etc/xrdp"
backup_root="/var/backups/xrdp-abnt2-reconcile"
max_backups=8

[ -d "$dst" ] || exit 0
[ -f "$src/xrdp_keyboard.ini" ] || exit 0
[ -f "$src/km-abnt2.ini" ] || exit 0
[ -f "$src/startwm.sh" ] || exit 0

needs_backup=0
for target in \
    "$dst/xrdp_keyboard.ini" \
    "$dst/km-00000409.ini" \
    "$dst/km-00000416.ini" \
    "$dst/km-00010416.ini" \
    "$dst/km-0000080a.ini" \
    "$dst/km-0000f010.ini" \
    "$dst/startwm.sh"; do
    [ -e "$target" ] || continue
    case "$target" in
        "$dst/xrdp_keyboard.ini") source="$src/xrdp_keyboard.ini" ;;
        "$dst/startwm.sh") source="$src/startwm.sh" ;;
        *) source="$src/km-abnt2.ini" ;;
    esac
    cmp -s "$source" "$target" || needs_backup=1
done

xrdp_ini="$dst/xrdp.ini"
if [ -f "$xrdp_ini" ]; then
    globals_overrides_present() {
        awk '
            BEGIN {
                required["xrdp.override_keyboard_type"] = "0x04"
                required["xrdp.override_keyboard_subtype"] = "0x00"
                required["xrdp.override_keylayout"] = "0x00000416"
            }
            /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
                in_globals = (tolower($0) ~ /^[[:space:]]*\[globals\][[:space:]]*$/)
                next
            }
            in_globals {
                line = $0
                sub(/^[[:space:]]*/, "", line)
                if (line !~ /^[#;]/ && index(line, "=") > 0) {
                    split(line, pair, "=")
                    key = pair[1]
                    value = substr(line, index(line, "=") + 1)
                    gsub(/[[:space:]]+$/, "", key)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    if (key in required) {
                        count[key]++
                        actual[key] = value
                    }
                }
            }
            END {
                invalid = 0
                for (key in required) {
                    if (count[key] != 1 || actual[key] != required[key]) invalid = 1
                }
                exit invalid
            }
        ' "$xrdp_ini"
    }
    globals_overrides_present || needs_backup=1
fi

if [ "$needs_backup" -eq 1 ]; then
    backup_dir="$backup_root/$(date +%Y%m%d-%H%M%S)"
    install -d -o root -g root -m 700 "$backup_dir"
    for target in "$dst"/xrdp_keyboard.ini "$dst"/km-*.ini "$dst"/startwm.sh "$dst"/xrdp.ini; do
        [ -f "$target" ] && cp -a "$target" "$backup_dir/"
    done
    find "$backup_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk -v keep="$max_backups" 'NR > keep {sub(/^[^ ]+ /, ""); print}' | while IFS= read -r old; do
        [ -n "$old" ] && rm -rf -- "$old"
    done
fi

install -o nobody -g nogroup -m 644 "$src/xrdp_keyboard.ini" "$dst/xrdp_keyboard.ini"
install -o nobody -g nogroup -m 644 "$src/km-abnt2.ini" "$dst/km-00000409.ini"
install -o nobody -g nogroup -m 644 "$src/km-abnt2.ini" "$dst/km-00000416.ini"
install -o nobody -g nogroup -m 644 "$src/km-abnt2.ini" "$dst/km-00010416.ini"
install -o nobody -g nogroup -m 644 "$src/km-abnt2.ini" "$dst/km-0000080a.ini"
install -o nobody -g nogroup -m 644 "$src/km-abnt2.ini" "$dst/km-0000f010.ini"
install -o nobody -g nogroup -m 755 "$src/startwm.sh" "$dst/startwm.sh"

if [ -f "$xrdp_ini" ]; then
    rendered="$(mktemp "${xrdp_ini}.XXXXXX")"
    if ! awk '
        BEGIN {
            required["xrdp.override_keyboard_type"] = "0x04"
            required["xrdp.override_keyboard_subtype"] = "0x00"
            required["xrdp.override_keylayout"] = "0x00000416"
            order[1] = "xrdp.override_keyboard_type"
            order[2] = "xrdp.override_keyboard_subtype"
            order[3] = "xrdp.override_keylayout"
        }
        function emit_missing(    i, key) {
            for (i = 1; i <= 3; i++) {
                key = order[i]
                if (!seen[key]) print key "=" required[key]
            }
        }
        /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
            if (in_globals) emit_missing()
            in_globals = (tolower($0) ~ /^[[:space:]]*\[globals\][[:space:]]*$/)
            if (in_globals) found_globals = 1
            print
            next
        }
        in_globals {
            line = $0
            sub(/^[[:space:]]*[#;]?[[:space:]]*/, "", line)
            if (index(line, "=") > 0) {
                key = substr(line, 1, index(line, "=") - 1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
                if (key in required) {
                    if (!seen[key]) print key "=" required[key]
                    seen[key] = 1
                    next
                }
            }
        }
        { print }
        END {
            if (in_globals) emit_missing()
            if (!found_globals) exit 2
        }
    ' "$xrdp_ini" > "$rendered"; then
        rm -f "$rendered"
        exit 1
    fi
    install -o root -g root -m 644 "$rendered" "$xrdp_ini"
    rm -f "$rendered"
fi
