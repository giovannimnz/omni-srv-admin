# Fleet-owned OCI Admin Phase 25 CoreDNS mutation boundary.
Defaults:ocarun env_reset
Defaults:ocarun !setenv
Defaults:ocarun secure_path=/usr/sbin:/usr/bin:/sbin:/bin

Cmnd_Alias OCI_ADMIN_COREDNS_V1 = \
  /usr/local/libexec/oci-admin-coredns-helper inspect --manifest-digest sha256\:be3fde76bdb4fb9d6e5c8944cb8da79921da2a45c67964265d3a61650b67dc84 --target-binding-digest sha256\:* --operation-id * --plan-hash sha256\:* --source-commit * --source-digest sha256\:* --projection-digest sha256\:* --helper-digest sha256\:* --short-name atius-srv-4 --fqdn atius-srv-4.atius.internal --expected-address 10.14.1.14 --sentinel ATIUS_RUNBOOK_RESULT_V1, \
  /usr/local/libexec/oci-admin-coredns-helper apply --manifest-digest sha256\:46e109c4b4909ac401368bfabb123d6e44c30e0ab4bd2bfe95df156c2bae6b60 --target-binding-digest sha256\:* --operation-id * --plan-hash sha256\:* --source-commit * --source-digest sha256\:* --projection-digest sha256\:* --discovery-digest sha256\:* --preimage-digest sha256\:* --desired-config-digest sha256\:* --helper-digest sha256\:* --backup-id * --backup-digest sha256\:* --short-name atius-srv-4 --fqdn atius-srv-4.atius.internal --expected-address 10.14.1.14 --previous-answer * --sentinel ATIUS_RUNBOOK_RESULT_V1, \
  /usr/local/libexec/oci-admin-coredns-helper rollback --manifest-digest sha256\:d15b19e3d09e59b40ea3b8547854f497c5818b89f7faaf7364afe7b211b43de6 --target-binding-digest sha256\:* --operation-id * --plan-hash sha256\:* --origin-operation-id * --backup-id * --backup-digest sha256\:* --discovery-digest sha256\:* --preimage-digest sha256\:* --desired-config-digest sha256\:* --helper-digest sha256\:* --short-name atius-srv-4 --fqdn atius-srv-4.atius.internal --previous-answer * --sentinel ATIUS_RUNBOOK_RESULT_V1

ocarun ALL=(root) NOPASSWD: OCI_ADMIN_COREDNS_V1
