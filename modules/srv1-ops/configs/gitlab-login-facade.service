[Unit]
Description=GitLab Same-Host Login Facade (Atius SSO PM2 Gold Standard)
After=network-online.target keycloak.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/node /opt/atius/gitlab-login-facade.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/atius
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
