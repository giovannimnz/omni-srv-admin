# Resource governor defaults — ATIUS-SRV-1
# Source of truth for on-demand profiles + snapshot thresholds.

RG_ROOT_DEVICE=/dev/sda
RG_LOG_DIR=/home/ubuntu/.logs/resource-governor

RG_SNAPSHOT_ALERT_DISK_PCT=95
RG_SNAPSHOT_ALERT_SWAP_PCT=85
RG_SNAPSHOT_ALERT_MEM_AVAILABLE_MIB=2048
RG_SNAPSHOT_ALERT_PSI_IO_FULL_AVG10=5.0
RG_SNAPSHOT_ALERT_PSI_MEMORY_FULL_AVG10=1.0

RG_POST_BUILD_CLEANUP_DELAY=5m
RG_POST_BUILD_SNAPSHOT_DELAY=15m
RG_POST_BUILD_AUDIT_DELAY=35m

RG_DISK_MAX_READ_MBS=480
RG_DISK_MAX_WRITE_MBS=106
RG_DISK_IO_LIMIT_PCT=85
RG_DISK_READ_LIMIT_MBS=407
RG_DISK_WRITE_LIMIT_MBS=90
RG_DEVICE=sda

RG_RUNTIME_OVERRIDE_FILE=/home/ubuntu/.config/omni/resource-governor.runtime.env
RG_WATCHDOG_STATE_FILE=/home/ubuntu/.local/state/omni/resource-governor-watchdog.json
RG_WATCHDOG_LOG_FILE=/home/ubuntu/.logs/resource-governor/watchdog.log
RG_WATCHDOG_DISK_CRITICAL_PCT=97
RG_WATCHDOG_SWAP_CRITICAL_PCT=95
RG_WATCHDOG_MEM_AVAILABLE_CRITICAL_MIB=1536
RG_WATCHDOG_PSI_IO_FULL_CRITICAL_AVG10=2.0
RG_WATCHDOG_PSI_MEMORY_FULL_CRITICAL_AVG10=0.5
RG_WATCHDOG_COOLDOWN_MINUTES=30
RG_WATCHDOG_AUDIT_COOLDOWN_MINUTES=120
RG_WATCHDOG_RECOVERY_DISK_PCT=92
RG_WATCHDOG_RECOVERY_SWAP_PCT=70
RG_WATCHDOG_RECOVERY_MEM_AVAILABLE_MIB=4096

RG_PROFILE_BUILDS_SLICE=omni-builds.slice
RG_PROFILE_BUILDS_CPU_QUOTA=200%
RG_PROFILE_BUILDS_CPU_WEIGHT=100
RG_PROFILE_BUILDS_MEMORY_HIGH=6G
RG_PROFILE_BUILDS_MEMORY_MAX=8G
RG_PROFILE_BUILDS_MEMORY_SWAP_MAX=1G
RG_PROFILE_BUILDS_IO_READ_BW=80M
RG_PROFILE_BUILDS_IO_WRITE_BW=40M
RG_PROFILE_BUILDS_IO_WEIGHT=100
RG_PROFILE_BUILDS_TASKS_MAX=8192

RG_PROFILE_INTERACTIVE_SLICE=omni-interactive.slice
RG_PROFILE_INTERACTIVE_CPU_QUOTA=125%
RG_PROFILE_INTERACTIVE_CPU_WEIGHT=50
RG_PROFILE_INTERACTIVE_MEMORY_HIGH=4G
RG_PROFILE_INTERACTIVE_MEMORY_MAX=6G
RG_PROFILE_INTERACTIVE_MEMORY_SWAP_MAX=512M
RG_PROFILE_INTERACTIVE_IO_READ_BW=60M
RG_PROFILE_INTERACTIVE_IO_WRITE_BW=30M
RG_PROFILE_INTERACTIVE_IO_WEIGHT=50
RG_PROFILE_INTERACTIVE_TASKS_MAX=4096

RG_PROFILE_TRANSFERS_SLICE=omni-transfers.slice
RG_PROFILE_TRANSFERS_CPU_QUOTA=100%
RG_PROFILE_TRANSFERS_CPU_WEIGHT=25
RG_PROFILE_TRANSFERS_MEMORY_HIGH=1G
RG_PROFILE_TRANSFERS_MEMORY_MAX=2G
RG_PROFILE_TRANSFERS_MEMORY_SWAP_MAX=256M
RG_PROFILE_TRANSFERS_IO_READ_BW=407M
RG_PROFILE_TRANSFERS_IO_WRITE_BW=90M
RG_PROFILE_TRANSFERS_IO_WEIGHT=25
RG_PROFILE_TRANSFERS_TASKS_MAX=2048
