# pm2-ubuntu.service (canonical PM2 system daemon wrapper)
# Managed by omni-srv-admin.
# 2026-06-18: single boot owner for ATS + Horistic.
# 2026-06-21: oneshot wrapper avoids systemd PIDFile protocol races during PM2 resurrect.
#
# IMPORTANT:
# - PM2 restore state is /home/ubuntu/.pm2/dump.pm2.
# - That dump must contain both namespaces: atius and horistic.
# - Legacy user oneshots ats-pm2.service, horistic-pm2.service and
#   atius-web.service are disabled live because they race with this unit.
# - After any PM2 topology change, run `pm2 save` and keep this unit as
#   the only automatic PM2 boot owner.

[Unit]
Description=PM2 process manager (ATS + Horistic canonical restore)
Documentation=https://pm2.keymetrics.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.13.1/bin:/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM2_HOME=/home/ubuntu/.pm2
ExecStart=/home/ubuntu/.nvm/versions/node/v24.13.1/lib/node_modules/pm2/bin/pm2 resurrect
ExecReload=/home/ubuntu/.nvm/versions/node/v24.13.1/lib/node_modules/pm2/bin/pm2 reload all
ExecStop=/home/ubuntu/.nvm/versions/node/v24.13.1/lib/node_modules/pm2/bin/pm2 kill
TimeoutStartSec=180
Restart=on-failure
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
