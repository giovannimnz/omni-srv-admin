[Unit]
Description=Resource governor watchdog daemon (continuous, 1s poll)
Documentation=file:///home/ubuntu/GitHub/omni-srv-admin/docs/operations/resource-governor.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /home/ubuntu/GitHub/omni-srv-admin/modules/srv1-ops/scripts/resource-governor-watchdog.py
WorkingDirectory=/home/ubuntu/GitHub/omni-srv-admin
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
