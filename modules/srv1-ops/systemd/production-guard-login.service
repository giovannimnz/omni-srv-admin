[Unit]
Description=Production Guard login/session read-only check
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 /home/ubuntu/GitHub/omni-srv-admin/modules/srv1-ops/scripts/production_guard.py doctor --json
WorkingDirectory=/home/ubuntu/GitHub/omni-srv-admin
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

