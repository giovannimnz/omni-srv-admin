# container-cloudbeaver.service
# Canonical source: omni-srv-admin. Rootless Podman, loopback-only edge.

[Unit]
Description=Podman container-cloudbeaver.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
RestartSec=15
TimeoutStopSec=70
SuccessExitStatus=143
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--sdnotify=conmon \
	--replace \
	--cpus 2 \
	-d \
	--name cloudbeaver \
	--network srv1-podman-v2 \
	-p 127.0.0.1:8978:8978 \
	-v /home/ubuntu/GitHub/containers/cloudbeaver/workspace_recent:/opt/cloudbeaver/workspace:rw \
	--user 8978:8978 \
	-e DBEAVER_UID=8978 \
	-e DBEAVER_GID=8978 \
	-e CLOUDBEAVER_APP_SUPPORTS_CUSTOM_CONNECTIONS=true docker.io/dbeaver/cloudbeaver:26.1.0
ExecStop=/usr/bin/podman stop \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
	-f \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
