[Unit]
Description=ATIUS-SRV-1 Inviolable Services Watchdog
Documentation=file://%h/GitHub/omni-srv-admin/docs/operations/resource-governor.md

[Service]
Type=oneshot
ExecStart=%h/GitHub/omni-srv-admin/modules/srv1-ops/scripts/inviolable-watchdog.sh
Nice=-20
OOMScoreAdjust=-1000
OOMPolicy=continue
Restart=no
KillMode=process
TimeoutStartSec=120
StandardOutput=append:%h/.logs/resource-governor/inviolable-watchdog.log
StandardError=append:%h/.logs/resource-governor/inviolable-watchdog.log
