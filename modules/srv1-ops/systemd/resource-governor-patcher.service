[Unit]
Description=Resource governor patcher — auto-migra processos pesados para slices omni-*
Documentation=file://%h/GitHub/omni-srv-admin/docs/operations/resource-governor.md
After=omni-builds.slice omni-interactive.slice omni-transfers.slice
Wants=omni-builds.slice omni-interactive.slice omni-transfers.slice

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/GitHub/omni-srv-admin/modules/srv1-ops/scripts/resource-governor-patcher.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
# 2026-06-11 fix: hard limits
MemoryMax=256M
CPUQuota=20%
TimeoutStopSec=15
OOMPolicy=stop
OOMScoreAdjust=-1000
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=timers.target
