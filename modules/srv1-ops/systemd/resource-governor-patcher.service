[Unit]
Description=Resource governor patcher — auto-migra processos pesados para slices omni-*
Documentation=file:///home/ubuntu/GitHub/omni-srv-admin/docs/operations/resource-governor.md
After=default.target omni-builds.slice omni-interactive.slice omni-transfers.slice

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/ubuntu/GitHub/omni-srv-admin/modules/srv1-ops/scripts/resource-governor-patcher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
