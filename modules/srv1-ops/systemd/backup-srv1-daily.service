[Unit]
Description=Enfileira backup diário resumível do SRV-1 para Google Drive
Documentation=https://github.com/giovannimnz/omni-srv-admin
ConditionHost=atius-srv-1*
# Rclone mount é opcional — o script usa rclone copy direto via API
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/scripts/rclone-fleet-queue.sh enqueue 1
StandardOutput=journal
StandardError=journal
WorkingDirectory=%h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Slice=omni-transfers.slice
TimeoutStartSec=5min
KillMode=control-group

[Install]
WantedBy=default.target
