[Unit]
Description=Backup diário SRV-1 → GDrive (04:00 BRT)

[Timer]
OnCalendar=*-*-* 04:00:00 America/Sao_Paulo
# Tolerância de 15min se a máquina desligar no horário
AccuracySec=15min
# Persistir se perder o trigger
Persistent=true
# Aleatorizar 0-30min pra não martelar quota da API
RandomizedDelaySec=30min
Unit=backup-srv1-daily.service

[Install]
WantedBy=timers.target
