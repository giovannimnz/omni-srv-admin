[Unit]
Description=Verified offload of ~/.backups and ~/backups to GDrive
Documentation=https://github.com/giovannimnz/omni-srv-admin
ConditionHost=atius-srv-1*
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/GitHub/omni-srv-admin/modules/srv1-ops/scripts/offload-dotbackups-to-gdrive.sh
StandardOutput=journal
StandardError=journal
WorkingDirectory=%h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Slice=omni-transfers.slice
CPUQuota=80%
TimeoutStartSec=12h
TimeoutStopSec=5min
KillMode=control-group

[Install]
WantedBy=default.target
