[Unit]
Description=Atius Fleet Backup & Schedule Control Web Dashboard
Documentation=https://storage.atius.io https://atius.com.br
After=network.target gdrive-mount.service
Wants=gdrive-mount.service
AssertPathIsDirectory=/mnt/gdrive

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/GitHub/omni-srv-admin
Environment="PYTHONPATH=/home/ubuntu/GitHub/omni-srv-admin/modules/fleet-backup-web:/home/ubuntu/GitHub/omni-srv-admin/cli"
Environment="OMNI_GDRIVE_BACKUP_ROOT=/mnt/gdrive/ATIUS-SRV"
ExecStart=/home/ubuntu/.venv-backup-web/bin/python3 -m uvicorn backend.app:app --host 0.0.0.0 --port 8085 --workers 2

Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Governanca de Recursos Institucional ATIUS (CPU <= 20% do Host)
CPUQuota=80%
Nice=10
CPUSchedulingPolicy=other
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Limites de Memoria e Descritores
LimitNOFILE=65536
MemoryMax=512M
MemoryHigh=256M

[Install]
WantedBy=multi-user.target
