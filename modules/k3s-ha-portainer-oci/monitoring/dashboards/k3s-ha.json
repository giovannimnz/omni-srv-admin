{
  "title": "K3s HA — Control Plane + Workers",
  "uid": "omni-k3s-ha",
  "tags": ["omni", "k3s", "m005"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, cluster)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_node_info{cluster=~\"$cluster\"}, node)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Nodes Ready",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\",cluster=~\"$cluster\"})", "legendFormat": "ready" },
        { "expr": "count(kube_node_info{cluster=~\"$cluster\"})", "legendFormat": "total" }
      ]
    },
    {
      "type": "stat",
      "title": "Pods Running",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(kube_pod_status_phase{phase=\"Running\",cluster=~\"$cluster\"})" }
      ]
    },
    {
      "type": "stat",
      "title": "etcd Has Leader",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "max by (cluster) (etcd_server_has_leader{cluster=~\"$cluster\"})" }
      ],
      "options": { "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "Container Restarts (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\"}[1h]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU per node",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",cluster=~\"$cluster\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Memory per node",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{cluster=~\"$cluster\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\"})) * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Network IO per node",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|flannel.*|wg.*\",cluster=~\"$cluster\"}[5m]) * 8",
          "legendFormat": "rx {{instance}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|flannel.*|wg.*\",cluster=~\"$cluster\"}[5m]) * 8",
          "legendFormat": "tx {{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    }
  ]
}
