[Unit]
Description=K3s Grafana local port-forward
After=k3s.service network-online.target
Wants=network-online.target
Requires=k3s.service

[Service]
Type=simple
ExecStart=/usr/local/bin/k3s kubectl -n monitoring port-forward --address 127.0.0.1 svc/omni-monitoring-grafana 3005:80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
