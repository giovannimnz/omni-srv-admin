[Unit]
Description=K3s Portainer local port-forward
After=k3s.service network-online.target
Wants=network-online.target
Requires=k3s.service

[Service]
Type=simple
ExecStart=/usr/local/bin/k3s kubectl -n portainer port-forward --address 127.0.0.1 svc/portainer 9443:9443
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
