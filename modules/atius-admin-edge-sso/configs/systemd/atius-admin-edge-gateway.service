[Unit]
Description=Atius Admin Edge SSO gateway for Grafana/Portainer/Docker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/libexec/atius/start-atius-admin-edge-gateway
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/atius /opt/atius /home/ubuntu/.secrets /usr/local/libexec/atius
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
