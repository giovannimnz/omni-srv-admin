[Unit]
Description=Omni Fleet local node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OMNI_HOST_ID=%H
Environment=OMNI_AGENT_INTERVAL_SECONDS=30
EnvironmentFile=-/etc/omni-srv-admin/fleet-agent.env
WorkingDirectory=%h/GitHub/omni-srv-admin
Environment=OMNI_SRV_ADMIN=%h/GitHub/omni-srv-admin
Environment=PYTHONPATH=%h/GitHub/omni-srv-admin/cli
ExecStart=/usr/bin/python3 -m omni fleet agent loop --host ${OMNI_HOST_ID} --interval ${OMNI_AGENT_INTERVAL_SECONDS} --apply
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
