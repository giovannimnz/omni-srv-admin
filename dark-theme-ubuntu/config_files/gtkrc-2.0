gtk-theme-name="Greybird-dark"
gtk-icon-theme-name="nuoveXT2"
gtk-font-name="SF Pro Display 10"
gtk-cursor-theme-name="DMZ-White"
gtk-cursor-theme-size=18
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-button-images=1
gtk-menu-images=1

style "omni-dark-style" {
    bg[NORMAL] = "#111318"
    bg[PRELIGHT] = "#1f2937"
    bg[ACTIVE] = "#05070a"
    bg[SELECTED] = "#2563eb"
    bg[INSENSITIVE] = "#151922"

    fg[NORMAL] = "#f8fafc"
    fg[PRELIGHT] = "#ffffff"
    fg[ACTIVE] = "#ffffff"
    fg[SELECTED] = "#ffffff"
    fg[INSENSITIVE] = "#7d8590"

    text[NORMAL] = "#f8fafc"
    text[PRELIGHT] = "#ffffff"
    text[ACTIVE] = "#ffffff"
    text[SELECTED] = "#ffffff"
    text[INSENSITIVE] = "#7d8590"

    base[NORMAL] = "#05070a"
    base[PRELIGHT] = "#111827"
    base[ACTIVE] = "#111318"
    base[SELECTED] = "#2563eb"
    base[INSENSITIVE] = "#111318"

    GtkTreeView::odd-row-color = "#0b0f14"
    GtkTreeView::even-row-color = "#05070a"
    GtkTreeView::allow-rules = 1
    GtkTreeView::indent-expanders = 1
}

style "omni-dark-separator" {
    bg[NORMAL] = "#30363d"
    bg[ACTIVE] = "#3b434d"
    bg[PRELIGHT] = "#3b434d"
}

style "omni-dark-header" {
    bg[NORMAL] = "#151922"
    fg[NORMAL] = "#f8fafc"
}

widget "*" style "omni-dark-style"
class "GtkWidget" style "omni-dark-style"
class "GtkEntry" style "omni-dark-style"
class "GtkTreeView" style "omni-dark-style"
class "GtkSeparator" style "omni-dark-separator"
class "GtkPaned" style "omni-dark-separator"
widget_class "*.<GtkTreeView>.<GtkButton>" style "omni-dark-header"
